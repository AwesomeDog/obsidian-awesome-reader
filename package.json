{
	"name": "obsidian-awesome-reader",
	"version": "0.1.5",
	"description": "Make Obsidian a proper Reader.",
	"private": true,
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run check && node esbuild.config.mjs production",
		"check": "npm run typecheck && npm run lint && npm test",
		"typecheck": "tsc",
		"lint": "eslint .",
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"release": "npm run build && node scripts/deploy.mjs --build",
		"deploy": "node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "epub", "pdf", "reader"],
	"author": "AwesomeDog",
	"license": "MIT",
	"repository": "github:AwesomeDog/obsidian-awesome-reader",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "26.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"esbuild": "0.28.2",
		"eslint": "10.9.1",
		"globals": "17.11.0",
		"obsidian": "1.13.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0"
	},
	"dependencies": {
		"epubjs": "0.3.93",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-reader": "2.0.15"
	},
	"overrides": {
		"@xmldom/xmldom": "0.9.12"
	}
}
